APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# SMTP para envio do link de redefinição de senha (exemplo Gmail com TLS)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senha-de-app-do-email
MAIL_DEFAULT_SENDER=seu-email@gmail.com
MAIL_SENDER_NAME=Estoque de Camarões
EMAIL_PROVIDER=SMTP
BREVO_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_TOKEN_MAX_AGE=3600
# Client ID OAuth do tipo aplicativo da Web (Google Identity Services)
GOOGLE_CLIENT_ID=
# Local development may use SQLite. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

